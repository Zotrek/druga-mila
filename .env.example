# URL Cloudflare Workera (proxy) — kończy się na /api/formatka
# NIE wstawiaj tu bezpośredniego script.google.com/…/exec (patrz cloudflare/SETUP.md)
# Bez tej zmiennej: Word lokalnie, bez auto-numeru i bez zapisu do Sheets
DRUGA_MILA_WEBAPP_URL=https://zwrotka-gas-proxy.<konto>.workers.dev/api/formatka

# ID arkusza formatki — tylko lokalnie / w sekretach, nie w publicznym index
# GOOGLE_FORMATKA_SHEETS_ID=

# Arkusz Bolęcin — ID ustawiasz w Apps Script Script properties (BOLECIN_SHEETS_ID), nie w froncie
# GOOGLE_BOLECIN_SHEETS_ID=

# Cache geokodowania (JSON, commitowany). Domyślnie: ./data/geocode-cache.json
# GEOCODE_CACHE_PATH=./data/geocode-cache.json

# Wynik buildu mapy (GitHub Pages = root). Domyślnie: ./index.html
# OUTPUT_HTML=./index.html

# User-Agent Nominatim (opcjonalnie)
# NOMINATIM_USER_AGENT=druga-mila/1.0 (kontakt@example.com)
